<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Restored packages stay inside the project folder, so the folder moves to another machine as one piece. -->
    <add key="globalPackagesFolder" value=".tools/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
